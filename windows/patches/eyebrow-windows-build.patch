diff --git a/cmake/InstallConanDependencies.cmake b/cmake/InstallConanDependencies.cmake
index e16cda4c47..b57a2896ba 100644
--- a/cmake/InstallConanDependencies.cmake
+++ b/cmake/InstallConanDependencies.cmake
@@ -167,0 +168,11 @@
+if(WIN32 AND NOT Crashpad_HANDLER_EXECUTABLE AND DEFINED CONAN_BIN_DIRS_CRASHPAD)
+    foreach(_crashpad_bin_dir IN LISTS CONAN_BIN_DIRS_CRASHPAD)
+        if(EXISTS "${_crashpad_bin_dir}/crashpad_handler.exe")
+            set(Crashpad_HANDLER_EXECUTABLE "${_crashpad_bin_dir}/crashpad_handler.exe"
+                CACHE FILEPATH "Path to the Crashpad handler executable"
+            )
+            break()
+        endif()
+    endforeach()
+endif()
