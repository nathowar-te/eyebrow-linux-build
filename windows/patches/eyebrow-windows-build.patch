diff --git a/libraries/unibrow/base/include/unibrow/base/win/ProviderUniqueResource.h b/libraries/unibrow/base/include/unibrow/base/win/ProviderUniqueResource.h
--- a/libraries/unibrow/base/include/unibrow/base/win/ProviderUniqueResource.h
+++ b/libraries/unibrow/base/include/unibrow/base/win/ProviderUniqueResource.h
@@ -12,3 +12,9 @@
-template <typename Provider, auto closeFunction>
-using ProviderUniqueHFile =
-    ProviderUniqueResource<HANDLE, Provider, closeFunction, INVALID_HANDLE_VALUE>;
+#if defined(__clang__)
+// Clang does not permit INVALID_HANDLE_VALUE as a pointer-valued non-type template argument.
+template <typename Provider, auto closeFunction>
+using ProviderUniqueHFile = ProviderUniqueHandle<Provider, closeFunction>;
+#else
+template <typename Provider, auto closeFunction>
+using ProviderUniqueHFile =
+    ProviderUniqueResource<HANDLE, Provider, closeFunction, INVALID_HANDLE_VALUE>;
+#endif
